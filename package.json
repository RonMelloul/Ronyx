{
  "name": "quantum-react-app",
  "version": "3.0.0",
  "description": "Ultimate AI-powered React optimization framework with quantum-level performance",
  "main": "QuantumApp.jsx",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "quantum-dev": "npm run start -- --quantum-mode",
    "quantum-build": "npm run build -- --quantum-optimization",
    "quantum-analyze": "npm run build && npx bundle-analyzer build/static/js/*.js",
    "quantum-test": "npm test -- --coverage --quantum-performance",
    "quantum-deploy": "npm run quantum-build && node scripts/quantum-deploy.js",
    "quantum-validate": "node scripts/quantum-validate.js",
    "quantum-monitor": "node scripts/quantum-monitor.js",
    "quantum-train": "node scripts/quantum-train.js",
    "quantum-benchmark": "node scripts/quantum-benchmark.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "react-scripts": "^5.0.1",
    "web-vitals": "^3.0.4",
    "react-error-boundary": "^4.0.4",
    "react-window": "^1.8.8",
    "react-virtualized-auto-sizer": "^1.0.7",
    "react-intersection-observer": "^9.4.3",
    "workbox-webpack-plugin": "^6.5.4",
    "workbox-core": "^6.5.4",
    "workbox-precaching": "^6.5.4",
    "workbox-routing": "^6.5.4",
    "workbox-strategies": "^6.5.4",
    "socket.io-client": "^4.6.1",
    "lodash": "^4.17.21",
    "date-fns": "^2.29.3",
    "framer-motion": "^10.0.1",
    "react-spring": "^9.6.1",
    "react-use": "^17.4.0",
    "react-query": "^3.39.3",
    "swr": "^2.1.0",
    "axios": "^1.3.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/user-event": "^14.4.3",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "typescript": "^4.9.5",
    "webpack-bundle-analyzer": "^4.8.0",
    "lighthouse": "^10.0.2",
    "puppeteer": "^19.6.3",
    "eslint": "^8.35.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^2.8.4",
    "husky": "^8.0.3",
    "lint-staged": "^13.1.2",
    "size-limit": "^8.2.4",
    "@size-limit/file": "^8.2.4",
    "@size-limit/webpack": "^8.2.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "react",
    "quantum",
    "optimization",
    "ai",
    "neural",
    "virtual-scrolling",
    "performance",
    "web-workers",
    "error-boundary",
    "state-management",
    "accessibility",
    "responsive",
    "progressive-web-app",
    "server-side-rendering",
    "typescript"
  ],
  "author": "Quantum React Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quantum-react/quantum-app.git"
  },
  "bugs": {
    "url": "https://github.com/quantum-react/quantum-app/issues"
  },
  "homepage": "https://quantum-react.dev",
  "quantum": {
    "version": "3.0.0",
    "features": {
      "virtualScrolling": true,
      "neuralOptimization": true,
      "predictiveLoading": true,
      "quantumScrolling": true,
      "memoryOptimization": true,
      "timeTravel": true,
      "aiOptimization": true,
      "adaptiveLayout": true,
      "errorRecovery": true,
      "accessibility": true
    },
    "performance": {
      "targetRenderTime": "16ms",
      "targetMemoryUsage": "50MB",
      "targetBundleSize": "650KB",
      "targetLighthouseScore": 95
    },
    "ai": {
      "modelVersion": "3.0",
      "learningRate": 0.001,
      "predictionConfidence": 0.85,
      "optimizationFrequency": "5s"
    }
  }
}